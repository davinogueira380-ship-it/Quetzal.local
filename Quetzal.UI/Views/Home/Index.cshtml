<section id="inicio">
    <div class="container">
        <p>
            Transformar espaços vai muito além da estética. Acreditamos que cada ambiente deve refletir
            a essência, os hábitos e a personalidade de quem o utiliza. Por isso, desenvolvemos
            projetos de interiores personalizados, pensados para unir funcionalidade,
            conforto e identidade em cada detalhe.
        </p>
    </div>
</section>

<section id="portfolio">
    <div class="container">

        <div class="apresentacao">
            <h2>Portfólio</h2>
            <p>Conheça alguns dos nossos projetos.</p>
        </div>

        @if (!Model.Portfolios.Any())
        {
            <p class="text-center py-5">Em breve, novos projetos por aqui.</p>
        }
        else
        {
            @for (var i = 0; i < Model.Portfolios.Count; i++)
            {
                var item = Model.Portfolios[i];
                var par = i % 2 == 0;

                // Capa = primeira foto selecionada (por Ordem); cai para ImagemUpload em registros antigos.
                var fotosPortfolio = FotosDoPortfolio(item);
                var capaUrl = fotosPortfolio.FirstOrDefault();
                var fotosJson = JsonSerializer.Serialize(fotosPortfolio);

                <ul data-ambiente="@item.AmbienteNome">
                    <li>
                        @if (par)
                        {
                            <div class="row gy-4 Projeto1">
                                <div class="col-12 col-lg-6">
                                    @if (capaUrl != null)
                                    {
                                        <div class="portfolio-capa" onclick="abrirGaleriaPortfolio(this)"
                                             data-fotos="@fotosJson" data-nome="@item.NomeProjeto" tabindex="0"
                                             role="button" aria-label="Ver galeria de @item.NomeProjeto"
                                             onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();abrirGaleriaPortfolio(this);}">
                                            <img src="@capaUrl" alt="@item.NomeProjeto" loading="lazy">
                                            <span class="portfolio-capa-dica">Ver galeria</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="imagem-placeholder">
                                            <span class="icone">🖼️</span>
                                            <span class="texto">Foto em breve</span>
                                        </div>
                                    }
                                </div>

                                <div class="col-12 col-lg-6">
                                    <div class="texto1">
                                        <h1>@item.NomeProjeto</h1>
                                        <p>@item.Descricao</p>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="row gy-4 Projeto2">
                                <div class="col-12 col-lg-6 order-2 order-lg-1">
                                    <div class="texto2">
                                        <h1>@item.NomeProjeto</h1>
                                        <p>@item.Descricao</p>
                                    </div>
                                </div>

                                <div class="col-12 col-lg-6 order-1 order-lg-2">
                                    @if (capaUrl != null)
                                    {
                                        <div class="portfolio-capa" onclick="abrirGaleriaPortfolio(this)"
                                             data-fotos="@fotosJson" data-nome="@item.NomeProjeto" tabindex="0"
                                             role="button" aria-label="Ver galeria de @item.NomeProjeto"
                                             onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();abrirGaleriaPortfolio(this);}">
                                            <img src="@capaUrl" alt="@item.NomeProjeto" loading="lazy">
                                            <span class="portfolio-capa-dica">Ver galeria</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="imagem-placeholder">
                                            <span class="icone">🖼️</span>
                                            <span class="texto">Foto em breve</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </li>
                </ul>
            }
        }
    </div>
</section>

@if (Model.AmbientesFiltro.Any())
{
    var fotosTodos = Model.Portfolios.SelectMany(FotosDoPortfolio).ToList();
    var fotosTodosJson = JsonSerializer.Serialize(fotosTodos);

    <section id="filtro-ambientes">
        <div class="linha-fade"></div>

        <div class="container filtro-ambientes-conteudo">
            <span class="filtro-ambientes-label">Filtre por ambiente:</span>

            <div class="filtro-ambientes-links">
                <a href="#" class="filtro-ambiente-link" data-fotos="@fotosTodosJson" data-nome="Todos os projetos"
                   onclick="event.preventDefault(); abrirGaleriaPortfolio(this)">Todos</a>

                @foreach (var ambiente in Model.AmbientesFiltro)
                {
                    var fotosAmbiente = Model.Portfolios
                        .Where(p => p.AmbienteNome == ambiente)
                        .SelectMany(FotosDoPortfolio)
                        .ToList();
                    var fotosAmbienteJson = JsonSerializer.Serialize(fotosAmbiente);

                    <a href="#" class="filtro-ambiente-link" data-fotos="@fotosAmbienteJson" data-nome="@ambiente"
                       onclick="event.preventDefault(); abrirGaleriaPortfolio(this)">@ambiente</a>
                }
            </div>
        </div>

        <div class="linha-fade"></div>
    </section>
}

